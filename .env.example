NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://matrix:matrix@localhost:5432/matrix_portfolio?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Object storage (S3-compatible — AWS S3, Cloudflare R2, or local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=matrix-portfolio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Public base URL for media, when the bucket is served from a different host
# than the S3 API. Required on Cloudflare R2: enable the bucket's "Public
# Development URL" (or attach a custom domain) and paste it here, e.g.
# https://pub-abc123.r2.dev — the r2.cloudflarestorage.com host does not serve
# objects to browsers, so images would 401 without this.
# Leave empty for MinIO, where the API host already serves objects.
S3_PUBLIC_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Global rate limiting (requests per window per client)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Privacy — pepper used to one-way hash IPs/session identifiers before storage
IP_HASH_PEPPER=replace-with-a-random-string

# Used to sign the httpOnly session cookies
COOKIE_SECRET=replace-with-a-random-string

# Swagger UI at /docs is always on outside production. Set this to 'true' to
# force it on in a production build too (handy when the local Docker stack
# runs NODE_ENV=production). Leave unset on a public deployment, or put the
# docs behind your own auth first.
SWAGGER_ENABLED=

# How many reverse proxies sit in front of the app.
# Set to 1 on Railway/Render/Fly/Heroku or behind nginx — otherwise every
# visitor looks like the load balancer, so they all share one rate-limit
# bucket and one busy user throttles everyone.
# Keep it 0 when the app is reachable directly, or X-Forwarded-For can be
# forged to bypass rate limits.
TRUST_PROXY=0

# Optional — used to build absolute links where needed
PUBLIC_APP_URL=http://localhost:3000

# Optional — seed script only, change immediately after first login
SEED_ADMIN_EMAIL=admin@matrix.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# Creates the first ADMIN on boot when no admin account exists yet. Intended
# for managed platforms with no shell into the container, where the admin API
# cannot be reached without an admin and the database is private.
# Same password rules as the API: 12+ chars, mixed case, a digit.
# Delete both once the account exists — they are ignored afterwards, but a
# password sitting in the environment is a standing risk.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
