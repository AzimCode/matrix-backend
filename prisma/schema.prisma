// THE MATRIX — SYSTEM PROFILE
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum AdminRole {
  ADMIN
  EDITOR
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum SystemStatusValue {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PROJECT_VIEW
  CV_DOWNLOAD
}

// ─────────────────────────────────────────────────────────────────────────
// Profile (singleton) + Matrix-specific presentation data
// ─────────────────────────────────────────────────────────────────────────

model Profile {
  id       String @id @default(cuid())

  name      String
  headline  String
  location  String?
  bio       String  @db.Text
  avatarUrl String?

  email       String?
  phone       String?
  website     String?
  socialLinks Json    @default("{}")

  availability AvailabilityStatus @default(AVAILABLE)

  // Matrix-specific visual/system data (backend owns data, not the animation)
  systemStatus     SystemStatusValue @default(ONLINE)
  accentColor      String            @default("#00ff41")
  profileVersion   String            @default("1.0.0")
  terminalMessages String[]          @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────
// Experience
// ─────────────────────────────────────────────────────────────────────────

model Experience {
  id String @id @default(cuid())

  company      String
  position     String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  description  String   @db.Text
  achievements String[] @default([])
  technologies String[] @default([])
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([current])
  @@map("experience")
}

// ─────────────────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id String @id @default(cuid())

  slug        String @unique
  title       String
  subtitle    String?
  description String @db.Text

  year   Int
  role   String?
  client String?

  coverImage String?

  liveUrl      String?
  githubUrl    String?
  caseStudyUrl String?

  featured  Boolean       @default(false)
  sortOrder Int           @default(0)
  status    ProjectStatus @default(PUBLISHED)

  technologies ProjectTechnology[]
  gallery      ProjectMedia[]
  analytics    AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([featured])
  @@index([status])
  @@index([sortOrder])
  @@map("projects")
}

model Technology {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String
  technologyId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  mediaId   String
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
  @@index([projectId, sortOrder])
  @@map("project_media")
}

// ─────────────────────────────────────────────────────────────────────────
// Skill Matrix
// ─────────────────────────────────────────────────────────────────────────

model Skill {
  id        String  @id @default(cuid())
  name      String  @unique
  category  String
  level     Int     @default(1) // 1-5
  years     Float?
  icon      String?
  color     String?
  sortOrder Int     @default(0)

  relationsFrom SkillRelation[] @relation("SkillRelationSource")
  relationsTo   SkillRelation[] @relation("SkillRelationTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
  @@map("skills")
}

model SkillRelation {
  skillId        String
  relatedSkillId String
  strength       Int    @default(1) // 1-5

  skill        Skill @relation("SkillRelationSource", fields: [skillId], references: [id], onDelete: Cascade)
  relatedSkill Skill @relation("SkillRelationTarget", fields: [relatedSkillId], references: [id], onDelete: Cascade)

  @@id([skillId, relatedSkillId])
  @@index([relatedSkillId])
  @@map("skill_relations")
}

// ─────────────────────────────────────────────────────────────────────────
// Education & Certificates
// ─────────────────────────────────────────────────────────────────────────

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?
  description String?   @db.Text
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("education")
}

model Certificate {
  id             String   @id @default(cuid())
  title          String
  issuer         String
  issueDate      DateTime
  credentialUrl  String?
  credentialId   String?
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────────────────
// Resume (CV) — file lives in object storage, not Postgres
// ─────────────────────────────────────────────────────────────────────────

model Resume {
  id         String   @id @default(cuid())
  fileUrl    String
  storageKey String
  version    String
  active     Boolean  @default(false)
  uploadedAt DateTime @default(now())

  @@index([active])
  @@map("resumes")
}

// ─────────────────────────────────────────────────────────────────────────
// Media library
// ─────────────────────────────────────────────────────────────────────────

model Media {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  url        String
  storageKey String   @unique
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  projects ProjectMedia[]

  @@map("media")
}

// ─────────────────────────────────────────────────────────────────────────
// Admin authentication
// ─────────────────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  revoked   Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  replacedBy String?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Analytics
// ─────────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id           String             @id @default(cuid())
  event        AnalyticsEventType
  projectId    String?
  sessionHash  String
  country      String?
  device       String?
  referrer     String?
  createdAt    DateTime           @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([createdAt])
  @@index([projectId])
  @@index([sessionHash])
  @@map("analytics_events")
}
